---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';
import { getPublishedPosts } from '../../lib/content';
import { formatDate, formatSize } from '../../lib/format';
import { fromDoc, fromPost } from '../../lib/markdown-export';

const [posts, docs, files] = await Promise.all([getPublishedPosts(), getCollection('docs'), getCollection('downloads')]);
const groups = [
  { id: 'posts', title: '文章与笔记', items: posts.map(fromPost) },
  { id: 'docs', title: '文档', items: docs.map(fromDoc) },
].filter((group) => group.items.length > 0);
files.sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
const hasTemplate = [...posts, ...docs, ...files].some(({ data }) => data.template);
const sizeOf = (markdown: string) => formatSize(new TextEncoder().encode(markdown).length);
---

<BaseLayout title="下载" description="文章、笔记和文档的 Markdown 原文下载。">
  <div class="container page-shell">
    <header class="page-header">
      <h1>下载</h1>
      <p class="lede">文章、笔记和文档都可以下载 Markdown 原文，用 Typora 等编辑器直接打开；需要 PDF 时，在文章页点“打印 / 存为 PDF”。</p>
    </header>
    {hasTemplate && <TemplateNotice />}
    {/* 这些条目和文章页内容相同，不进搜索索引，免得搜索结果里出现两次。 */}
    {groups.map((group) => (
      <section class="download-group" aria-labelledby={`download-${group.id}`}>
        <h2 id={`download-${group.id}`}>{group.title}<span class="group-count">{group.items.length}</span></h2>
        <ul class="post-list">
          {group.items.map((item) => (
            <li class="post-row download-row">
              <time class="post-date" datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
              <div class="post-main">
                <h3 class="post-title"><a href={item.page}>{item.title}</a></h3>
                <p class="post-summary">{item.summary}</p>
              </div>
              <p class="download-file">
                <span>Markdown · {sizeOf(item.markdown(Astro.site!))}</span>
                <a class="button secondary compact" href={item.file} download={item.fileName} aria-label={`下载《${item.title}》的 Markdown`}>下载</a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {files.length > 0 && (
      <section class="download-group" aria-labelledby="download-files" data-pagefind-body data-pagefind-meta="type:下载">
        <h2 id="download-files" data-pagefind-meta="listing:true">其他资料<span class="group-count">{files.length}</span></h2>
        <div class="card-grid two-up">
          {files.map((item) => (
            <article class="card file-card">
              <p class="file-type" aria-hidden="true" data-pagefind-ignore>{item.data.fileType}</p>
              <h3 id={`download-${item.id}`}>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              <dl class="facts">
                <div><dt>格式</dt><dd>{item.data.fileType}</dd></div>
                <div><dt>大小</dt><dd>{item.data.fileSize}</dd></div>
                <div><dt>版本</dt><dd>{item.data.version}</dd></div>
                <div><dt>更新</dt><dd><time datetime={item.data.updatedDate.toISOString()}>{formatDate(item.data.updatedDate)}</time></dd></div>
              </dl>
              {item.data.template && <TemplateNotice compact />}
              <p class="card-actions" data-pagefind-ignore><a class="button" href={item.data.downloadUrl} download>下载文件</a></p>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
