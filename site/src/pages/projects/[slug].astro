---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';

type Props = { project: CollectionEntry<'projects'> };

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as Props;
const { Content, headings } = await render(project);
---

<DetailLayout
  title={project.data.title}
  description={project.data.summary}
  crumb={{ href: '/projects/', label: '项目' }}
  transitionName={`project-${project.id}`}
  headings={headings}
  template={project.data.template}
  kind="project"
>
  <Fragment slot="meta">
    <p class="detail-meta"><span class="status" data-status={project.data.status}>{project.data.status}</span></p>
    <ul class="stack" aria-label="技术栈">{project.data.techStack.map((tech) => <li>{tech}</li>)}</ul>
  </Fragment>
  <p class="callout"><strong>本人贡献：</strong>{project.data.role}</p>
  <Content />
  <nav class="detail-links" aria-label="项目相关链接" data-pagefind-ignore>
    {project.data.repoUrl && <a class="button secondary" href={project.data.repoUrl}>代码仓库</a>}
    {project.data.demoUrl && <a class="button secondary" href={project.data.demoUrl}>在线 Demo</a>}
    {project.data.videoUrl && <a class="button secondary" href={project.data.videoUrl}>演示视频</a>}
    <a class="button" href="/projects/">返回项目列表</a>
  </nav>
</DetailLayout>
