---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';

const resumeSections = (await getCollection('resume')).sort((a, b) => a.data.order - b.data.order);
const hasTemplate = resumeSections.some(({ data }) => data.template);

/** “标签：内容”拆成两段，标签加粗。 */
const splitLabel = (item: string) => {
  const at = item.indexOf('：');
  return at > 0 ? { label: item.slice(0, at), text: item.slice(at + 1) } : { label: '', text: item };
};
---

<BaseLayout title="简历" description="求职意向、教育背景、专业技能和项目经历摘要。">
  <div class="container page-shell">
    <header class="page-header"><h1>简历</h1><p class="lede">简历摘要，项目细节见各项目页。</p></header>
    {hasTemplate && <TemplateNotice />}
    <section class="resume-sheet" aria-label="简历摘要">
      {resumeSections.map(({ data: section }) => (
        <article class:list={['resume-block', { 'is-wide': section.items }]}>
          <h2>{section.title}</h2>
          {section.content && <p>{section.content}</p>}
          {section.items && (
            <ul>
              {section.items.map((item) => {
                const { label, text } = splitLabel(item);
                return <li>{label && <strong>{label}：</strong>}{text}</li>;
              })}
            </ul>
          )}
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
