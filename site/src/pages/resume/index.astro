---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';

const resumeSections = (await getCollection('resume')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="简历" description="网页版简历摘要和脱敏 PDF 下载入口。">
  <div class="container page-shell">
    <header class="page-header"><h1>简历</h1><p class="lede">网页版摘要与可下载 PDF 保持互补，真实内容替换后再用于公开展示。</p></header>
    <TemplateNotice />
    <section class="resume-sheet" aria-label="简历摘要">
      {resumeSections.map(({ data: section }) => (
        <article class="resume-block">
          <h2>{section.title}</h2>
          <p>{section.content}</p>
        </article>
      ))}
    </section>
    <section class="section download-band" aria-labelledby="resume-download">
      <div>
        <h2 id="resume-download">下载 PDF</h2>
        <p>当前为已脱敏的模板文件，不代表真实个人履历。</p>
      </div>
      <a class="button" href="/downloads/resume-template.pdf" download>下载模板 PDF</a>
    </section>
  </div>
</BaseLayout>
