---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';
import { resumeSections } from '../../data/site';
---

<BaseLayout title="简历" description="网页版简历摘要和脱敏 PDF 下载入口。">
  <div class="container page-shell">
    <header class="page-header"><p class="eyebrow">Resume</p><h1>简历</h1><p class="lede">网页版摘要与可下载 PDF 保持互补，真实内容替换后再用于公开展示。</p></header>
    <TemplateNotice />
    <section class="card-grid" aria-label="简历摘要">
      {resumeSections.map((section) => <article class="card"><h2>{section.title}</h2><p>{section.content}</p></article>)}
    </section>
    <section class="section" aria-labelledby="resume-download">
      <h2 id="resume-download">下载 PDF</h2>
      <p>当前为已脱敏的模板文件，不代表真实个人履历。</p>
      <a class="button" href="/downloads/resume-template.pdf" download>下载模板 PDF</a>
    </section>
  </div>
</BaseLayout>
