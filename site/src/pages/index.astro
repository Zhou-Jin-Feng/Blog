---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TemplateNotice from '../components/TemplateNotice.astro';
import ContentGraph from '../components/ContentGraph.astro';
import PostRow from '../components/PostRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { siteConfig } from '../data/site';
import { getPublishedPosts } from '../lib/content';

const posts = (await getPublishedPosts()).slice(0, 3);
const projects = (await getCollection('projects', ({ data }) => data.featured)).slice(0, 2);
const hasTemplate = [...posts, ...projects].some(({ data }) => data.template);
---

<BaseLayout title="首页">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{siteConfig.name}</h1>
        <p class="lede">记录学习笔记、技术文档和个人工程实践，把过程整理成可阅读、可复现的公开内容。</p>
        <div class="hero-actions">
          <a class="button" href="/blog/">阅读博客</a>
          <a class="button secondary" href="/projects/">查看项目</a>
        </div>
      </div>
      <ContentGraph />
    </div>
  </section>

  <div class="container">
    {hasTemplate && <TemplateNotice />}
    <section class="section" aria-labelledby="featured-projects">
      <div class="section-heading"><h2 id="featured-projects">精选项目</h2><a class="text-link" href="/projects/">全部项目</a></div>
      <div class="card-grid two-up">
        {projects.map((project) => <ProjectCard project={project} headingLevel="h3" />)}
      </div>
    </section>

    <section class="section" aria-labelledby="latest-posts">
      <div class="section-heading"><h2 id="latest-posts">最新文章</h2><a class="text-link" href="/blog/">全部文章</a></div>
      <ol class="post-list">
        {posts.map((post) => <PostRow post={post} headingLevel="h3" />)}
      </ol>
    </section>

    <section class="section" aria-labelledby="quick-links">
      <div class="section-heading"><h2 id="quick-links">快速入口</h2></div>
      <div class="card-grid quick-grid">
        <article class="card quick-card"><h3><a href="/resume/">网页版简历</a></h3><p>求职意向、专业技能和项目经历摘要。</p></article>
        <article class="card quick-card"><h3><a href="/docs/">技术文档</a></h3><p>按版本和更新时间整理的文档目录。</p></article>
        <article class="card quick-card"><h3><a href="/about/">关于与联系</a></h3><p>了解技术方向，通过邮箱、微信或 GitHub 联系。</p></article>
      </div>
    </section>
  </div>
</BaseLayout>
