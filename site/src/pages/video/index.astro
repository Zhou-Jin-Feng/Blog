---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';

const videos = await getCollection('videos');
---

<BaseLayout title="视频" description="项目演示视频和文字摘要。">
  <div class="container page-shell">
    <header class="page-header"><p class="eyebrow">Video</p><h1>视频</h1><p class="lede">每个视频都提供关联项目、摘要和直接访问链接。</p></header>
    <TemplateNotice />
    <div class="card-grid">
      {videos.map((video) => (
        <article class="card">
          <p class="card-meta">{video.data.platform} · 关联项目：{video.data.projectSlug}</p>
          <h2>{video.data.title}</h2>
          <p>{video.data.summary}</p>
          {video.data.template && <TemplateNotice compact />}
          <p><a class="button secondary" href={video.data.videoUrl} target="_blank" rel="noreferrer">直接访问视频</a></p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
