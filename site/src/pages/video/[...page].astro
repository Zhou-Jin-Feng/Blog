---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';
import { features } from '../../data/site';

// 用剩余参数路由是为了能按开关决定生成与否：page 为 undefined 时对应 /video/ 本身；栏目隐藏时不生成，访问返回 404。
export function getStaticPaths() {
  return features.videos ? [{ params: { page: undefined } }] : [];
}

const [videos, projects] = await Promise.all([getCollection('videos'), getCollection('projects')]);
const projectTitle = new Map(projects.map((project) => [project.id, project.data.title]));
const hasTemplate = videos.some(({ data }) => data.template);
---

<BaseLayout title="视频" description="项目演示视频和文字摘要。">
  <div class="container page-shell" data-pagefind-body data-pagefind-meta="type:视频">
    <header class="page-header" data-pagefind-meta="listing:true"><h1>视频</h1><p class="lede">每个视频都提供关联项目、摘要和直接访问链接。</p></header>
    {hasTemplate && <TemplateNotice />}
    <div class="card-grid two-up">
      {videos.map((video) => (
        <article class="card media-card">
          <div class="media-placeholder" role="img" aria-label="演示视频封面占位" data-pagefind-ignore>
            <span>演示视频</span>
            <strong>封面待补充</strong>
          </div>
          <p class="card-meta">
            <span class="pill">{video.data.platform}</span>
            {projectTitle.has(video.data.projectSlug)
              ? <a href={`/projects/${video.data.projectSlug}/`}>关联项目：{projectTitle.get(video.data.projectSlug)}</a>
              : <span>关联项目：{video.data.projectSlug}</span>}
          </p>
          <h2 id={`video-${video.id}`}>{video.data.title}</h2>
          <p>{video.data.summary}</p>
          {video.data.template && <TemplateNotice compact />}
          <p class="card-actions" data-pagefind-ignore><a class="button secondary" href={video.data.videoUrl} target="_blank" rel="noreferrer">打开视频链接</a></p>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
