---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import { formatDate } from '../../lib/format';

type Props = { doc: CollectionEntry<'docs'> };

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props as Props;
const { Content, headings } = await render(doc);
---

<DetailLayout
  title={doc.data.title}
  description={doc.data.summary}
  crumb={{ href: '/docs/', label: '文档' }}
  transitionName={`doc-${doc.id}`}
  headings={headings}
  template={doc.data.template}
>
  <p class="detail-meta" slot="meta">
    <span class="version">{doc.data.version}</span>
    <span>更新于 <time datetime={doc.data.updatedDate.toISOString()}>{formatDate(doc.data.updatedDate)}</time></span>
    <span>来源：{doc.data.source}</span>
  </p>
  <Content />
  <p><a href="/docs/">返回文档列表</a></p>
</DetailLayout>
