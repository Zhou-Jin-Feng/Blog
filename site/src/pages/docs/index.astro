---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateNotice from '../../components/TemplateNotice.astro';

const docs = (await getCollection('docs')).sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
---

<BaseLayout title="文档" description="按版本和更新时间整理的技术文档。">
  <div class="container page-shell">
    <header class="page-header"><p class="eyebrow">Docs</p><h1>文档</h1><p class="lede">为长期维护准备的结构化文档目录。</p></header>
    <TemplateNotice />
    <ul class="list">
      {docs.map((doc) => (
        <li class="list-item">
          <p class="card-meta">{doc.data.version} · <time datetime={doc.data.updatedDate.toISOString()}>{doc.data.updatedDate.toLocaleDateString('zh-CN')}</time></p>
          <h2><a href={`/docs/${doc.id}/`}>{doc.data.title}</a></h2><p>{doc.data.summary}</p><p class="card-meta">来源：{doc.data.source}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
