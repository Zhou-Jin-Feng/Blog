---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-title">{siteConfig.name}</p>
      <p class="footer-note">以 Markdown 记录可阅读、可复现的工程实践。</p>
    </div>
    <div class="footer-links">
      <a href="/rss.xml" data-astro-reload>RSS</a>
      <a href="/sitemap-index.xml" data-astro-reload>Sitemap</a>
      <a href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} {siteConfig.name}</p></div>
</footer>
