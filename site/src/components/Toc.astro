---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const sections = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
// 长笔记的三级标题动辄上百个，全列出来目录比正文还难找，这时只列二级标题。
const items = sections.length > 30 ? sections.filter((heading) => heading.depth === 2) : sections;
---

{items.length >= 2 && (
  <nav class="toc" aria-label="本文目录" data-toc data-pagefind-ignore>
    <p class="toc-title">本文目录</p>
    <ol>
      {items.map((heading) => (
        <li class:list={[`toc-depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  let observer: IntersectionObserver | undefined;

  document.addEventListener('astro:page-load', () => {
    observer?.disconnect();
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (!toc) return;
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => links.set(decodeURIComponent(link.hash.slice(1)), link));
    const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
    const visible = new Set<string>();

    const mark = (id: string | undefined) => {
      links.forEach((link, key) => {
        if (key === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const current = id ? links.get(id) : undefined;
      // 目录比屏幕高时会出现滚动条，让当前章节留在可见范围内。
      if (current && toc.scrollHeight > toc.clientHeight) {
        const box = toc.getBoundingClientRect();
        const item = current.getBoundingClientRect();
        if (item.top < box.top || item.bottom > box.bottom) toc.scrollTop += item.top - box.top - box.height / 3;
      }
    };

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        const first = headings.find((heading) => visible.has(heading.id));
        if (first) {
          mark(first.id);
          return;
        }
        // 两个标题之间的长段落：取视口上方最近的一个。
        const above = headings.filter((heading) => heading.getBoundingClientRect().top < 0).at(-1);
        mark(above?.id ?? headings[0]?.id);
      },
      { rootMargin: '-72px 0px -55% 0px' },
    );
    headings.forEach((heading) => observer!.observe(heading));
  });

  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
