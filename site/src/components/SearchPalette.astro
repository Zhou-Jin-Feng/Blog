---
import { navItems } from '../data/site';
import { collectContent } from '../lib/content';
import { formatDate } from '../lib/format';
import { kindMeta } from '../lib/kinds';

// 输入框为空时列出最近内容；栏目页面按标题在本地匹配。正文检索交给 Pagefind。
const recent = (await collectContent()).slice(0, 8).map((item) => ({
  type: kindMeta[item.kind].label,
  title: item.title,
  summary: item.summary,
  href: item.href,
  date: item.date && formatDate(item.date),
}));
const pages = navItems.map((item) => ({ type: '页面', title: item.label, summary: item.summary, href: item.href }));
const payload = JSON.stringify({ recent, pages }).replace(/</g, '\\u003c');
---

<dialog class="palette" aria-label="站内搜索" data-palette>
  <div class="palette-box">
    <div class="palette-field">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-results"
        aria-autocomplete="list"
        aria-label="搜索文章、项目和文档"
        placeholder="搜索文章、项目、文档或标签"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <button class="palette-close" type="button" data-palette-close>
        <kbd>Esc</kbd><span class="visually-hidden">关闭搜索</span>
      </button>
    </div>
    <ul class="palette-results" id="palette-results" role="listbox" aria-label="搜索结果" data-palette-results></ul>
    <p class="palette-empty" data-palette-empty hidden>没有找到匹配的内容，换个关键词或标签试试。</p>
    <p class="palette-empty" data-palette-loading hidden>正在加载搜索索引…</p>
    <p class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </p>
  </div>
  <p class="visually-hidden" aria-live="polite" data-palette-status></p>
  <script is:inline type="application/json" data-palette-data set:html={payload} />
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';

  type Entry = { type: string; title: string; summary: string; href: string; date?: string; excerpt?: string };
  type PagefindData = {
    url: string;
    excerpt: string;
    /** 整页的纯文本。 */
    content: string;
    meta: Record<string, string | undefined>;
    sub_results: { url: string; title: string; excerpt: string }[];
  };
  type SearchResponse = { results: { data: () => Promise<PagefindData> }[] };
  type Pagefind = {
    options: (options: Record<string, unknown>) => Promise<void>;
    search: (term: string) => Promise<SearchResponse>;
    debouncedSearch: (term: string, options?: object, timeout?: number) => Promise<SearchResponse | null>;
  };

  // 索引由构建脚本里的 pagefind 生成，astro dev 下不存在。用变量拼路径，避免 Vite 去解析它。
  const PAGEFIND_URL = '/pagefind/pagefind.js';
  const MAX_RESULTS = 12;
  /** 中文补充匹配时最多核对的候选页数。 */
  const CANDIDATE_LIMIT = 40;
  /** 连续两个及以上的汉字。 */
  const CJK_RUN = /[㐀-鿿豈-﫿]{2,}/g;
  const segmenter = 'Segmenter' in Intl ? new Intl.Segmenter('zh', { granularity: 'word' }) : undefined;

  type PaletteData = { recent: Entry[]; pages: Entry[] };

  let pagefind: Promise<Pagefind | undefined> | undefined;
  /** 首次搜索要下载 Pagefind 的脚本和索引，加载完之前显示提示。 */
  let engineReady = false;
  const paletteData = new WeakMap<HTMLDialogElement, PaletteData>();
  let results: Entry[] = [];
  let active = 0;
  let latest = 0;

  const loadPagefind = () => {
    pagefind ??= import(/* @vite-ignore */ PAGEFIND_URL)
      .then(async (module: Pagefind) => {
        await module.options({ excerptLength: 24 });
        engineReady = true;
        return module;
      })
      .catch(() => {
        pagefind = undefined;
        return undefined;
      });
    return pagefind;
  };

  const els = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');
    if (!dialog) return undefined;
    return {
      dialog,
      input: dialog.querySelector<HTMLInputElement>('[data-palette-input]')!,
      list: dialog.querySelector<HTMLUListElement>('[data-palette-results]')!,
      empty: dialog.querySelector<HTMLElement>('[data-palette-empty]')!,
      loading: dialog.querySelector<HTMLElement>('[data-palette-loading]')!,
      status: dialog.querySelector<HTMLElement>('[data-palette-status]')!,
    };
  };

  /** 每次换页对话框都是新的，按元素缓存解析结果。 */
  function readData(dialog: HTMLDialogElement) {
    let data = paletteData.get(dialog);
    if (!data) {
      data = JSON.parse(dialog.querySelector('[data-palette-data]')!.textContent!) as PaletteData;
      paletteData.set(dialog, data);
    }
    return data;
  }

  function highlight(text: string, terms: string[]) {
    const fragment = document.createDocumentFragment();
    if (!terms.length) {
      fragment.append(text);
      return fragment;
    }
    const lower = text.toLowerCase();
    let cursor = 0;
    while (cursor < text.length) {
      let hit = -1;
      let length = 0;
      for (const term of terms) {
        const at = lower.indexOf(term, cursor);
        if (at !== -1 && (hit === -1 || at < hit)) {
          hit = at;
          length = term.length;
        }
      }
      if (hit === -1) {
        fragment.append(text.slice(cursor));
        break;
      }
      fragment.append(text.slice(cursor, hit));
      const mark = document.createElement('mark');
      mark.textContent = text.slice(hit, hit + length);
      fragment.append(mark);
      cursor = hit + length;
    }
    return fragment;
  }

  /** Pagefind 的摘要是带 <mark> 的 HTML。只保留文字和 <mark>，其余标签一律当纯文本。 */
  function excerpt(html: string) {
    const template = document.createElement('template');
    template.innerHTML = html;
    const fragment = document.createDocumentFragment();
    template.content.childNodes.forEach((node) => {
      if (node.nodeName === 'MARK') {
        const mark = document.createElement('mark');
        mark.textContent = node.textContent;
        fragment.append(mark);
      } else {
        fragment.append(node.textContent ?? '');
      }
    });
    return fragment;
  }

  function toEntries(data: PagefindData): Entry[] {
    const type = data.meta.type ?? '';
    // 视频、下载没有详情页：每张卡片算一个结果，直接跳到卡片的锚点。
    if (data.meta.listing) {
      return data.sub_results
        .filter((sub) => sub.url.includes('#'))
        .map((sub) => ({ type, title: sub.title, summary: '', excerpt: sub.excerpt, href: sub.url }));
    }
    return [{ type, title: data.meta.title ?? '', summary: '', excerpt: data.excerpt, href: data.url, date: data.meta.date }];
  }

  const escapeHtml = (text: string) => text.replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char]!);
  const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

  /** 在原文里截取命中处前后的一段，命中的词用 <mark> 包起来，格式与 Pagefind 的摘要一致。 */
  function excerptAround(content: string, run: string) {
    const at = content.indexOf(run);
    const start = Math.max(0, at - 20);
    const end = Math.min(content.length, at + run.length + 40);
    return `${start > 0 ? '…' : ''}${escapeHtml(content.slice(start, at))}<mark>${escapeHtml(run)}</mark>${escapeHtml(content.slice(at + run.length, end))}${end < content.length ? '…' : ''}`;
  }

  /**
   * Pagefind 建索引时“镜像”“调试”是整词，浏览器切分查询时（Intl.Segmenter）却切成单字，
   * 结果这些词搜不到。查询里有会被切成单字的中文时，返回需要按原文补充匹配的片段。
   */
  function fragileRuns(query: string) {
    return (query.match(CJK_RUN) ?? []).filter((run) => !segmenter || [...segmenter.segment(run)].some(({ segment }) => segment.length === 1));
  }

  /** 每段中文只留第一个字，借 Pagefind 的前缀匹配拿到候选页，再逐页核对原文里是否真有这些词。 */
  async function substringMatches(engine: Pagefind, query: string, runs: string[]) {
    const response = await engine.search(query.replace(CJK_RUN, (run) => ` ${run[0]} `));
    const candidates = await Promise.all(response.results.slice(0, CANDIDATE_LIMIT).map((result) => result.data()));
    const hits = (text: string) => runs.reduce((sum, run) => sum + text.split(run).length - 1, 0);
    return candidates
      .filter((page) => runs.every((run) => page.content.includes(run)))
      .map((page) => ({ page, inTitle: runs.every((run) => (page.meta.title ?? '').includes(run)), count: hits(page.content) }))
      .sort((a, b) => Number(b.inTitle) - Number(a.inTitle) || b.count - a.count)
      .map(({ page }) => ({
        ...page,
        excerpt: excerptAround(page.content, runs[0]),
        sub_results: page.sub_results.filter((sub) => runs.some((run) => `${sub.title}${stripTags(sub.excerpt)}`.includes(run))),
      }));
  }

  /** 返回 undefined 表示这次查询已被更新的输入取代。 */
  async function searchContent(query: string) {
    const engine = await loadPagefind();
    if (!engine) return [];
    const response = await engine.debouncedSearch(query, {}, 120);
    if (!response) return undefined;
    let data = await Promise.all(response.results.slice(0, MAX_RESULTS).map((result) => result.data()));
    const runs = fragileRuns(query);
    if (runs.length) {
      // 原文里确实出现查询词的页面排在前面，Pagefind 其余的结果接在后面。
      const exact = await substringMatches(engine, query, runs);
      const seen = new Set(exact.map((page) => page.url));
      data = [...exact, ...data.filter((page) => !seen.has(page.url))];
    }
    return data.flatMap(toEntries).slice(0, MAX_RESULTS);
  }

  /** 栏目页面：标题命中的排在正文结果前面，只有摘要命中的排在后面。 */
  function matchPages(pages: Entry[], terms: string[]) {
    const hits = pages.filter((page) => terms.every((term) => `${page.title}${page.summary}${page.type}`.toLowerCase().includes(term)));
    const byTitle = (page: Entry) => terms.some((term) => page.title.toLowerCase().includes(term));
    return { lead: hits.filter(byTitle), rest: hits.filter((page) => !byTitle(page)) };
  }

  async function update() {
    const ui = els();
    if (!ui) return;
    const query = ui.input.value.trim().replace(/^#/, '');
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    const run = ++latest;
    const data = readData(ui.dialog);

    let next = data.recent;
    if (terms.length) {
      if (!engineReady) showLoading(ui);
      const content = await searchContent(query);
      if (content === undefined || run !== latest) return;
      const { lead, rest } = matchPages(data.pages, terms);
      next = [...lead, ...content, ...rest];
      if (import.meta.env.DEV && !(await loadPagefind())) {
        ui.empty.textContent = '开发模式下没有搜索索引：先运行 npm run build，再用 npm run preview 查看。';
      }
    }
    render(ui, next, terms);
  }

  function showLoading(ui: NonNullable<ReturnType<typeof els>>) {
    results = [];
    ui.list.replaceChildren();
    ui.input.setAttribute('aria-activedescendant', '');
    ui.empty.hidden = true;
    ui.loading.hidden = false;
    ui.status.textContent = '正在加载搜索索引';
  }

  function render(ui: NonNullable<ReturnType<typeof els>>, entries: Entry[], terms: string[]) {
    results = entries;
    active = 0;
    ui.loading.hidden = true;
    ui.list.replaceChildren(
      ...results.map((entry, i) => {
        const item = document.createElement('li');
        item.id = `palette-option-${i}`;
        item.setAttribute('role', 'option');
        const link = document.createElement('a');
        link.href = entry.href;
        link.tabIndex = -1;
        const type = document.createElement('span');
        type.className = 'option-type';
        type.dataset.type = entry.type;
        type.textContent = entry.type;
        const body = document.createElement('span');
        body.className = 'option-body';
        const title = document.createElement('span');
        title.className = 'option-title';
        title.append(highlight(entry.title, terms));
        const summary = document.createElement('span');
        summary.className = 'option-summary';
        summary.append(entry.excerpt ? excerpt(entry.excerpt) : highlight(entry.summary, terms));
        body.append(title, summary);
        link.append(type, body);
        if (entry.date) {
          const date = document.createElement('time');
          date.className = 'option-date';
          date.textContent = entry.date;
          link.append(date);
        }
        item.append(link);
        item.addEventListener('pointermove', () => setActive(i));
        return item;
      }),
    );
    ui.empty.hidden = results.length > 0;
    ui.status.textContent = terms.length ? `找到 ${results.length} 条结果` : '';
    setActive(0);
  }

  function setActive(i: number) {
    const ui = els();
    if (!ui) return;
    active = i;
    const options = [...ui.list.querySelectorAll<HTMLElement>('[role="option"]')];
    options.forEach((option, k) => option.setAttribute('aria-selected', String(k === i)));
    const current = options[i];
    ui.input.setAttribute('aria-activedescendant', current ? current.id : '');
    current?.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    const ui = els();
    if (!ui || ui.dialog.open) return;
    ui.dialog.showModal();
    ui.input.value = '';
    ui.input.focus();
    update();
  }

  function close() {
    els()?.dialog.close();
  }

  document.addEventListener('keydown', (event) => {
    const ui = els();
    if (!ui) return;
    const typing = (event.target as Element).closest('input, textarea, select, [contenteditable="true"]');
    if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      if (ui.dialog.open) close();
      else open();
      return;
    }
    if (event.key === '/' && !typing && !ui.dialog.open) {
      event.preventDefault();
      open();
      return;
    }
    if (!ui.dialog.open || event.target !== ui.input) return;
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (!results.length) return;
      const delta = event.key === 'ArrowDown' ? 1 : -1;
      setActive((active + delta + results.length) % results.length);
    } else if (event.key === 'Enter' && results[active]) {
      event.preventDefault();
      const href = results[active].href;
      close();
      navigate(href);
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('[data-search-open]')) {
      open();
      return;
    }
    const ui = els();
    if (!ui?.dialog.open) return;
    if (target === ui.dialog || target.closest('[data-palette-close]') || target.closest('.palette-results a')) close();
  });

  document.addEventListener('input', (event) => {
    if ((event.target as Element).matches('[data-palette-input]')) update();
  });

  // 鼠标移到搜索按钮上就预先加载 Pagefind，打开时基本无需等待。
  document.addEventListener('pointerover', (event) => {
    if ((event.target as Element).closest('[data-search-open]')) loadPagefind();
  });
</script>
