---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TemplateNotice from '../components/TemplateNotice.astro';
import Toc from '../components/Toc.astro';
import { formatDate } from '../lib/format';
import { kindMeta, type ContentKind } from '../lib/kinds';
import { AI_NOTE, type Downloadable } from '../lib/markdown-export';
import type { ArticleMeta } from '../lib/og';

interface Props {
  title: string;
  /** 同时用作页面描述和标题下的导语。 */
  description: string;
  crumb: { href: string; label: string };
  /** 与列表页标题共用的过渡名，换页时标题平滑过渡。 */
  transitionName: string;
  headings: MarkdownHeading[];
  template: boolean;
  /** 写进搜索索引，搜索面板据此显示类型和日期。 */
  kind: ContentKind;
  date?: Date;
  /** 有值时在标题下显示“下载 Markdown”和“打印 / 存为 PDF”。 */
  download?: Downloadable;
  aiAssisted?: boolean;
  /** 分享图路径（见 lib/og.ts 的 ogImagePath）和 article:* 信息。 */
  image: string;
  article: ArticleMeta;
}

const { title, description, crumb, transitionName, headings, template, kind, date, download, aiAssisted = false, image, article } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} article={article}>
  <div class="read-progress" aria-hidden="true"></div>
  <div class="container page-shell">
    {/* Pagefind 一个属性只认一组 key:value，类型和日期分开挂。 */}
    <article class="article" data-pagefind-body data-pagefind-meta={`type:${kindMeta[kind].label}`}>
      <header class="detail-header" data-pagefind-meta={date && `date:${formatDate(date)}`}>
        <p class="crumb" data-pagefind-ignore><a href={crumb.href}>{crumb.label}</a></p>
        <h1 transition:name={transitionName}>{title}</h1>
        <p class="lede">{description}</p>
        <slot name="meta" />
        {download && (
          <p class="detail-actions" data-pagefind-ignore>
            <a class="button secondary compact" href={download.file} download={download.fileName}>下载 Markdown</a>
            <button class="button secondary compact" type="button" data-print>打印 / 存为 PDF</button>
          </p>
        )}
      </header>
      <div class="article-layout">
        <div class="prose">
          {template && <TemplateNotice />}
          <slot />
          {aiAssisted && <p class="ai-note" data-pagefind-ignore>{AI_NOTE}</p>}
        </div>
        <Toc headings={headings} />
      </div>
      <slot name="after" />
    </article>
  </div>
</BaseLayout>

<script>
  // 打印前临时切到浅色主题：深色主题的浅色文字和代码高亮印到白纸上看不清。
  let themeBeforePrint: string | undefined;
  addEventListener('beforeprint', () => {
    themeBeforePrint = document.documentElement.dataset.theme;
    document.documentElement.dataset.theme = 'light';
  });
  addEventListener('afterprint', () => {
    if (themeBeforePrint) document.documentElement.dataset.theme = themeBeforePrint;
    themeBeforePrint = undefined;
  });
  document.addEventListener('click', (event) => {
    if ((event.target as Element).closest('[data-print]')) print();
  });
</script>
